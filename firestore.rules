rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {
      allow read: if true; // let everyone see public usernames
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // PROMPTS
    match /prompts/{promptId} {
      allow read: if true; // anyone can view prompts
      allow create: if request.auth != null; // logged-in users can post
      allow update, delete: if request.auth != null && request.resource.data.ownerUID == request.auth.uid;
    }

    // FAVORITES (user saves)
    match /favorites/{favId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
